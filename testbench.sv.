
`timescale 1ns/1ps

module testbench;

    reg clk;
    reg rst_n;
    reg signed [15:0] sensor_sample;
    reg sample_valid;
    reg [16:0] threshold;
    reg [16:0] hysteresis;

    wire signed [15:0] filtered_output;
    wire filtered_valid;
    wire vibration_alarm;

    integer i;
    integer errors;

    aerosense8_top dut (
        .clk(clk),
        .rst_n(rst_n),
        .sensor_sample(sensor_sample),
        .sample_valid(sample_valid),
        .threshold(threshold),
        .hysteresis(hysteresis),
        .filtered_output(filtered_output),
        .filtered_valid(filtered_valid),
        .vibration_alarm(vibration_alarm)
    );

    always #5 clk = ~clk;

    task send_sample;
        input signed [15:0] value;
        begin
            @(negedge clk);
            sensor_sample = value;
            sample_valid = 1'b1;
            @(negedge clk);
            sample_valid = 1'b0;
        end
    endtask

    initial begin
        clk = 0;
        rst_n = 0;
        sensor_sample = 0;
        sample_valid = 0;
        threshold = 1000;
        hysteresis = 200;
        errors = 0;

        $dumpfile("aerodsp_x_top.vcd");
        $dumpvars(0, testbench);

        repeat (3) @(negedge clk);
        rst_n = 1;

        // TEST 1: Normal vibration
        for (i = 0; i < 20; i = i + 1)
            send_sample(100);

        repeat (12) @(negedge clk);

        if (vibration_alarm == 0)
            $display("PASS: Normal vibration");
        else begin
            $display("FAIL: Normal vibration");
            errors = errors + 1;
        end

        // TEST 2: High vibration detection
        for (i = 0; i < 20; i = i + 1)
            send_sample(10000);

        repeat (12) @(negedge clk);

        if (vibration_alarm == 1)
            $display("PASS: High vibration detected");
        else begin
            $display("FAIL: High vibration not detected");
            errors = errors + 1;
        end

        // TEST 3: Alarm clearing
        for (i = 0; i < 30; i = i + 1)
            send_sample(0);

        repeat (12) @(negedge clk);

        if (vibration_alarm == 0)
            $display("PASS: Alarm cleared");
        else begin
            $display("FAIL: Alarm not cleared");
            errors = errors + 1;
        end

        $display("------------------------------");
        if (errors == 0)
            $display("RESULT: ALL TESTS PASSED");
        else
            $display("RESULT: %0d TESTS FAILED", errors);

        $display("------------------------------");

        $finish;
    end

endmodule
