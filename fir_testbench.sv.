
module fir_testbench;

    reg clk;
    reg rst_n;
    reg signed [15:0] sample_in;
    reg sample_valid;

    wire signed [15:0] filtered_sample;
    wire filtered_valid;

    integer total_tests;
    integer passed;
    integer failed;
    integer i;
    integer seed;

    reg signed [15:0] history [0:7];
    reg signed [63:0] sum;
    reg signed [63:0] scaled;
    reg signed [15:0] expected;

    aerosense_fir8 dut (
        .clk(clk),
        .rst_n(rst_n),
        .sample_in(sample_in),
        .sample_valid(sample_valid),
        .filtered_sample(filtered_sample),
        .filtered_valid(filtered_valid)
    );

    always #5 clk = ~clk;

    task calculate_expected;
        begin
            sum =
                history[0] * 117 +
                history[1] * 1248 +
                history[2] * 5277 +
                history[3] * 9742 +
                history[4] * 9742 +
                history[5] * 5277 +
                history[6] * 1248 +
                history[7] * 117;

            scaled = sum >>> 15;

            if (scaled > 32767)
                expected = 32767;
            else if (scaled < -32768)
                expected = -32768;
            else
                expected = scaled[15:0];
        end
    endtask

    task send_and_check;
        input signed [15:0] value;
        begin
            @(negedge clk);
            sample_in = value;
            sample_valid = 1'b1;

            calculate_expected;

            @(posedge clk);
            #1;

            total_tests = total_tests + 1;

            if (filtered_valid &&
                filtered_sample === expected) begin
                passed = passed + 1;
            end
            else begin
                failed = failed + 1;
                $display("FAIL: input=%0d expected=%0d actual=%0d",
                         value, expected, filtered_sample);
            end

            for (i = 7; i > 0; i = i - 1)
                history[i] = history[i-1];

            history[0] = value;

            @(negedge clk);
            sample_valid = 1'b0;
        end
    endtask

    initial begin
        clk = 0;
        rst_n = 0;
        sample_in = 0;
        sample_valid = 0;

        total_tests = 0;
        passed = 0;
        failed = 0;
        seed = 12345;

        for (i = 0; i < 8; i = i + 1)
            history[i] = 0;

        repeat (3) @(posedge clk);
        @(negedge clk);
        rst_n = 1;

        $display("TEST 1: IMPULSE RESPONSE");
        send_and_check(16000);
        repeat (12)
            send_and_check(0);

        $display("TEST 2: STEP RESPONSE");
        repeat (20)
            send_and_check(10000);

        $display("TEST 3: NEGATIVE INPUTS");
        repeat (15)
            send_and_check(-8000);

        $display("TEST 4: BOUNDARY INPUTS");
        send_and_check(32767);
        send_and_check(-32768);
        send_and_check(32767);
        send_and_check(-32768);

        $display("TEST 5: ALTERNATING INPUTS");
        for (i = 0; i < 20; i = i + 1) begin
            if (i % 2 == 0)
                send_and_check(15000);
            else
                send_and_check(-15000);
        end

        $display("TEST 6: RANDOM INPUTS");
        for (i = 0; i < 100; i = i + 1)
            send_and_check($random(seed));

        $display("");
        $display("AERODSP-X FIR VERIFICATION SUMMARY");
        $display("TOTAL TESTS : %0d", total_tests);
        $display("PASSED      : %0d", passed);
        $display("FAILED      : %0d", failed);
        $display("================================");

        if (failed == 0)
            $display("RESULT: ALL FIR TESTS PASSED");
        else
            $display("RESULT: FIR TESTS FAILED");

        $finish;
    end

endmodule
