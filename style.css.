
:root {
  --background: #07111f;
  --surface: #101e30;
  --accent: #37d6f5;
  --text: #edf5ff;
  --muted: #a5b6ca;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--text);
  font-family: Arial, sans-serif;
  line-height: 1.7;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22px 8%;
  background: #091525;
  border-bottom: 1px solid #1c344c;
  position: sticky;
  top: 0;
  z-index: 10;
}

.logo {
  color: white;
  font-size: 23px;
  font-weight: bold;
  text-decoration: none;
  letter-spacing: 2px;
}

.logo span {
  color: var(--accent);
}

nav {
  display: flex;
  gap: 22px;
  flex-wrap: wrap;
}

nav a {
  color: var(--muted);
  text-decoration: none;
  font-size: 13px;
}

nav a:hover {
  color: var(--accent);
}

.hero {
  min-height: 540px;
  padding: 120px 10%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(circle at 85% 25%, #123c58 0%, transparent 35%),
    linear-gradient(120deg, #07111f, #10243a);
}

.eyebrow {
  color: var(--accent);
  font-size: 12px;
  letter-spacing: 3px;
  margin-bottom: 18px;
  font-weight: bold;
}

.hero h1 {
  max-width: 850px;
  font-size: clamp(34px, 6vw, 64px);
  line-height: 1.15;
  margin-bottom: 24px;
}

.hero-text {
  color: var(--muted);
  max-width: 620px;
  margin-bottom: 30px;
  font-size: 17px;
}

.primary-button {
  background: var(--accent);
  color: #061321;
  padding: 13px 24px;
  border-radius: 5px;
  text-decoration: none;
  font-weight: bold;
  width: fit-content;
}

.primary-button:hover {
  background: white;
}

.status {
  color: #8ca4bd;
  font-size: 11px;
  letter-spacing: 2px;
  margin-top: 45px;
}

.section {
  padding: 85px 10%;
  border-bottom: 1px solid #1b3046;
}

.section h2 {
  font-size: 32px;
  margin-bottom: 20px;
}

.section > p:not(.eyebrow) {
  color: var(--muted);
  max-width: 850px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 20px;
  margin-top: 35px;
}

.card {
  background: var(--surface);
  border: 1px solid #23415b;
  padding: 27px;
  border-radius: 9px;
  transition: transform 0.25s, border-color 0.25s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: var(--accent);
}

.card h3 {
  color: var(--accent);
  margin-bottom: 12px;
}

.card p {
  color: var(--muted);
  font-size: 14px;
}

.architecture {
  max-width: 500px;
  margin: 35px auto 0;
  text-align: center;
}

.architecture div {
  padding: 18px;
  background: var(--surface);
  border: 1px solid var(--accent);
  border-radius: 7px;
  font-weight: bold;
}

.architecture span {
  display: block;
  color: var(--accent);
  font-size: 25px;
  padding: 7px;
}

.notice {
  background: #182b40;
  border-left: 3px solid var(--accent);
  padding: 18px;
  margin-top: 25px;
  color: var(--muted);
}

footer {
  padding: 30px 10%;
  text-align: center;
  color: var(--muted);
  font-size: 13px;
}

@media (max-width: 700px) {
  .navbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
  }

  nav {
    gap: 12px;
  }

  .hero {
    padding: 85px 7%;
  }

  .section {
    padding: 65px 7%;
  }
}
